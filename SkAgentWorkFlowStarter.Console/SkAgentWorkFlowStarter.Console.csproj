<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0"/>
        <PackageReference Include="Microsoft.SemanticKernel" Version="1.67.1"/>
        <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.67.1"/>
        <PackageReference Include="Microsoft.SemanticKernel.PromptTemplates.Handlebars" Version="1.67.1"/>
        <PackageReference Include="YamlDotNet" Version="16.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Samples\MyAgents\IncidentTriageAgent\Prompts\IncidentTriagePrompt.yaml"/>
        <EmbeddedResource Include="Samples\MyAgents\IncidentTriageAgent\Prompts\IncidentTriagePrompt.yaml"/>
        <None Remove="Samples\MyAgents\SummarizationAgent\Prompts\SummarizationPrompt.yaml"/>
        <EmbeddedResource Include="Samples\MyAgents\SummarizationAgent\Prompts\SummarizationPrompt.yaml"/>
    </ItemGroup>


    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>
</Project>
